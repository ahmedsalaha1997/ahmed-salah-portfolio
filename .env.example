# Required by the local content API. Do not expose this value with a VITE_ prefix.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional settings
CONTENT_API_PORT=8787
ALLOWED_ORIGIN=http://127.0.0.1:5174

# Required for production with Supabase. These are safe public client values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
